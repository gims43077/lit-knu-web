# LIT x MSA 250 Challenge - Azure 클라우드 연동 환경변수 설정 예시

# Azure Static Web Apps / Azure Functions 백엔드 API URL
VITE_AZURE_FUNCTIONS_API_URL=https://lit-msa-functions.azurewebsites.net/api
VITE_AZURE_FUNCTIONS_KEY=your-functions-host-key-here

# Azure Cosmos DB (NoSQL API) 연결 정보 (Functions 서버리스 백엔드에서 참조)
AZURE_COSMOS_DB_ENDPOINT=https://lit-knu-cosmos.documents.azure.com:443/
AZURE_COSMOS_DB_KEY=your-primary-key-here
AZURE_COSMOS_DB_DATABASE=LitMsaDatabase
AZURE_COSMOS_DB_CONTAINER=Challenges

